# Redis Configuration
REDIS_URL=redis://redis:6379/0

# FastAPI Configuration
ENVIRONMENT=development
SECRET_KEY=your_secret_key_here

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here

# AWS Configuration (Optional)
