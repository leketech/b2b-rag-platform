apiVersion: v1
kind: Secret
metadata:
  name: b2b-rag-secrets
  namespace: default
type: Opaque
stringData:
  DATABASE_URL: "postgresql+asyncpg://postgres:YOUR_PASSWORD@your-rds-endpoint:5432/b2b_rag_db"
  REDIS_URL: "redis://your-redis-endpoint:6379/0"
  OPENAI_API_KEY: "sk-..."
  ENVIRONMENT: "staging"
  LOG_LEVEL: "INFO"
